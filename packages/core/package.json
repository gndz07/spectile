{
  "name": "@spectile/core",
  "version": "0.1.0-beta.0",
  "description": "Parse and normalize OpenAPI documents into a render-ready model",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gndz07/spectile.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/gndz07/spectile/tree/main/packages/core#readme",
  "bugs": "https://github.com/gndz07/spectile/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@scalar/json-magic": "^0.15.7",
    "@scalar/openapi-parser": "^0.29.13"
  }
}
