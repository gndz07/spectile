{
  "name": "@spectile/react",
  "version": "0.1.0-beta.0",
  "description": "React hooks and unstyled primitives for rendering OpenAPI documents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gndz07/spectile.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/gndz07/spectile/tree/main/packages/react#readme",
  "bugs": "https://github.com/gndz07/spectile/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@spectile/core": "workspace:^",
    "@spectile/headless": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.3.0"
  }
}
