{
  "name": "@spectile/headless",
  "version": "0.1.0-beta.0",
  "description": "Framework-agnostic state and behavior for rendering OpenAPI documents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gndz07/spectile.git",
    "directory": "packages/headless"
  },
  "homepage": "https://github.com/gndz07/spectile/tree/main/packages/headless#readme",
  "bugs": "https://github.com/gndz07/spectile/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
